# Copy to .env and fill in. Never commit .env.

# LLM, any OpenAI-compatible endpoint. Model names change: check the provider's model list first.
# Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1           LLM_MODEL=openai/gpt-oss-120b  (checked 2026-10-27)
# Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# Qdrant Cloud. Leave QDRANT_URL empty to use local storage in data/qdrant
QDRANT_URL=
QDRANT_API_KEY=
COLLECTION=documents_paragraph

SEARCH_MODE=hybrid
